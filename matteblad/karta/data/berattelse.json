{
  "version": 1,
  "titel": "Stjärnkartan",
  "platser": {
    "hem": {
      "namn": "Hemmet",
      "text": "Här började resan. Stugan bredvid byggdes för mynt från matteblad."
    },
    "skola": {
      "namn": "Skolan",
      "text": "Varje prov ger 1 till 3 stjärnor. Stjärnorna öppnar portarna ut i världen."
    },
    "glanta": {
      "namn": "Skogsgläntan",
      "text": "En solig glänta mitt i granskogen. Här skulle bin trivas."
    },
    "hemlig": {
      "namn": "Hemliga gläntan",
      "text": "Få hittar hit. Det växer konstiga svampar mellan träden."
    },
    "host": {
      "namn": "Höstskogen",
      "text": "Löven är orange här året runt. Perfekt för en fruktlund."
    },
    "sjo": {
      "namn": "Sjöviken",
      "text": "Vid stranden går det att bygga en fiskebod."
    },
    "fiske": {
      "namn": "Fiskeläget",
      "text": "Ett litet läge vid älven. Härifrån går en väg norrut mot tornet."
    },
    "torn": {
      "namn": "Tornet",
      "text": "Från tornet syns slottet. Det är inte långt kvar."
    },
    "slott": {
      "namn": "Slottet",
      "text": "Terminens mål. Hit kommer den som samlat 20 stjärnor."
    }
  },
